  status                                String
  capturedCents                         Int                    @default(0)
  refundedCents                         Int                    @default(0)
  failureCode                           String                 @default("")
  reconciliationReference               String                 @default("")
  reconciledAt                          DateTime?
  version                               Int                    @default(1)
  idempotencyKey                        String                 @unique @default("")
  from_PaymentRefund_transaction        PaymentRefund[]        @relation("PaymentRefund_transaction")
  from_PaymentProviderEvent_transaction PaymentProviderEvent[] @relation("PaymentProviderEvent_transaction")

  @@index([rooftopId])
  @@index([dealId])
  @@index([serviceOrderId])
  @@index([paymentProviderId])
}

model PaymentRefund {
  id                               String                 @id @default(cuid())
  createdAt                        DateTime               @default(now())
  updatedAt                        DateTime               @default(now()) @updatedAt
  rooftop                          Rooftop                @relation("PaymentRefund_rooftop", fields: [rooftopId], references: [id])
  rooftopId                        String                 @map("rooftop")
  transaction                      PaymentTransaction     @relation("PaymentRefund_transaction", fields: [transactionId], references: [id])
  transactionId                    String                 @map("transaction")
  amountCents                      Int
  reason                           String                 @default("")
  status                           String
  providerRefundId                 String                 @default("")
  failureCode                      String                 @default("")
  idempotencyKey                   String                 @unique @default("")
  from_PaymentProviderEvent_refund PaymentProviderEvent[] @relation("PaymentProviderEvent_refund")

  @@index([rooftopId])
  @@index([transactionId])
}

model PaymentProviderEvent {
  id                 String             @id @default(cuid())
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now()) @updatedAt
  rooftop            Rooftop            @relation("PaymentProviderEvent_rooftop", fields: [rooftopId], references: [id])
  rooftopId          String             @map("rooftop")
  transaction        PaymentTransaction @relation("PaymentProviderEvent_transaction", fields: [transactionId], references: [id])
  transactionId      String             @map("transaction")
  refund             PaymentRefund?     @relation("PaymentProviderEvent_refund", fields: [refundId], references: [id])
  refundId           String?            @map("refund")
  providerKey        String             @default("")
  providerEventId    String             @unique @default("")
  eventType          String             @default("")
  payloadDigest      String             @default("")
  signatureTimestamp DateTime
  receivedAt         DateTime

  @@index([rooftopId])
  @@index([transactionId])
  @@index([refundId])
}

model PaymentProvider {
  id                          String               @id @default(cuid())
  name                        String               @default("")
  code                        String               @unique @default("")
  isInstalled                 Boolean              @default(true)
  credentials                 Json?                @default("{}")
  metadata                    Json?                @default("{}")
  createPaymentFunction       String               @default("")
  capturePaymentFunction      String               @default("")
  refundPaymentFunction       String               @default("")
  getPaymentStatusFunction    String               @default("")
  generatePaymentLinkFunction String               @default("")
  handleWebhookFunction       String               @default("")
  transactions                PaymentTransaction[] @relation("PaymentTransaction_paymentProvider")
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @default(now()) @updatedAt
}

model SavedReport {
  id                         String      @id @default(cuid())
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @default(now()) @updatedAt
  rooftop                    Rooftop     @relation("SavedReport_rooftop", fields: [rooftopId], references: [id])
  rooftopId                  String      @map("rooftop")
  owner                      User        @relation("SavedReport_owner", fields: [ownerId], references: [id])
  ownerId                    String      @map("owner")
  name                       String      @default("")
  reportType                 String
  filters                    Json?       @default("{}")
  exportFormat               String
  schedule                   String
  active                     Boolean     @default(true)
  nextRunAt                  DateTime?
  idempotencyKey             String      @unique @default("")
  from_ReportRun_savedReport ReportRun[] @relation("ReportRun_savedReport")

  @@index([rooftopId])
  @@index([ownerId])
}

model ReportRun {
  id             String      @id @default(cuid())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt
  rooftop        Rooftop     @relation("ReportRun_rooftop", fields: [rooftopId], references: [id])
  rooftopId      String      @map("rooftop")
  savedReport    SavedReport @relation("ReportRun_savedReport", fields: [savedReportId], references: [id])
  savedReportId  String      @map("savedReport")
  status         String
  exportFormat   String
  resultSnapshot Json?       @default("{}")
  resultDigest   String      @default("")
  errorCode      String      @default("")
  completedAt    DateTime?
  expiresAt      DateTime?
  idempotencyKey String      @unique @default("")

  @@index([rooftopId])
  @@index([savedReportId])
}

model RetentionPolicy {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  rooftop        Rooftop   @relation("RetentionPolicy_rooftop", fields: [rooftopId], references: [id])
  rooftopId      String    @map("rooftop")
  category       String
  retentionDays  Int
  legalHold      Boolean   @default(false)
  rationale      String    @default("")
  lastSweptAt    DateTime?
  idempotencyKey String    @unique @default("")

  @@unique([rooftopId, category], map: "RetentionPolicy_rooftop_category_key")
  @@index([rooftopId])
}

model AuthenticationThrottle {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  keyHash         String    @unique @default("")
  purpose         String    @default("")
  failureCount    Int       @default(0)
  windowStartedAt DateTime
  blockedUntil    DateTime?

  @@index([updatedAt])
  @@index([blockedUntil])
}

model ApiKey {
  id              String            @id @default(cuid())
  name            String            @default("")
  tokenSecret     String
  tokenPreview    String            @default("")
  scopes          Json?             @default("[]")
  status          ApiKeyStatusType? @default(active)
  expiresAt       DateTime?
  lastUsedAt      DateTime?
  usageCount      Json?             @default("{\"total\":0,\"daily\":{}}")
  restrictedToIPs Json?             @default("[]")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt
  user            User?             @relation("ApiKey_user", fields: [userId], references: [id])
  userId          String?           @map("user")

  @@index([userId])
}

enum ApiKeyStatusType {
  active
  inactive
  revoked
}
